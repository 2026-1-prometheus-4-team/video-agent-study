# Core LLM (Gemini)
GOOGLE_API_KEY=your_google_api_key_here
# (optional) 역할별 키 분산 — rate limit 여유 확보 (agent/llm.py 자동 인식, 미지정 시 GOOGLE_API_KEY)
# GOOGLE_API_KEY_SUPERVISOR=
# GOOGLE_API_KEY_SCRIPT=
# GOOGLE_API_KEY_CRITIC=
# GOOGLE_API_KEY_SUB_AGENT=

# (optional) 모델 오버라이드 — 미지정 시 config.py 기본값 (gemini-3.5-flash)
# MODEL_SUPERVISOR=
# MODEL_SCRIPT=
# MODEL_CRITIC=
# MODEL_SUB_AGENT=

# 전사 엔진 (transcribe.py) — 기본 openai (현재 코드는 Gemini 전사 경로), 폴백 faster-whisper
# WHISPER_ENGINE=openai
# WHISPER_CHUNK_SECONDS=120

# Research expert (external APIs)
# Tavily — https://app.tavily.com (월 1000 검색 무료)
TAVILY_API_KEY=your_tavily_api_key_here
# YouTube Data API v3 — Google Cloud Console > YouTube Data API v3 활성화 (일 10k unit 무료)
YOUTUBE_API_KEY=your_youtube_api_key_here

# (optional) Anthropic 폴백 / Claude 사용 시
# ANTHROPIC_API_KEY=sk-ant-...
# (optional) OpenAI fallback 등
# OPENAI_API_KEY=sk-...

# TTS / AI BGM generation (ElevenLabs)
# https://elevenlabs.io/docs/api-reference/music/compose
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=your_default_voice_id_here
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_MUSIC_MODEL=music_v2
ELEVENLABS_MUSIC_OUTPUT_FORMAT=mp3_44100_128

# ---- frontend/motion-editor/.env.local 용 ----
# NEXT_PUBLIC_AGENT_API=http://localhost:8000   # 배포 시 백엔드 도메인 (https)
# ELEVENLABS_API_KEY=                            # 에디터 AI 패널용 (서버 라우트 전용)
