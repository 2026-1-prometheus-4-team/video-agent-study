# =============================================================
# Video Agent — .gitignore
# =============================================================

# ── Python / venv ──
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ── OS / IDE ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── 환경 변수 (모든 위치) ──
# 루트 · backend/ · frontend/ 어디에 있든 .env 는 절대 커밋 X.
.env
.env.local
.env.*.local
.env.production
.env.development

# ── Frontend (Next.js) ──
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ── 미디어 입력 · 편집 산출물 · 분석 캐시 (전부 로컬 재생성 가능) ──
# 폴더 자체는 .gitkeep 으로만 유지. 내용은 전부 로컬 전용.
# 하위 디렉토리도 재귀적으로 (glob 은 한 depth 만 잡아서 subtitles/ 등 제외 실패
# 방지). "!"" 예외로 .gitkeep 만 tracked 상태 유지.
backend/videos/**
!backend/videos/
!backend/videos/.gitkeep
!backend/videos/subtitles/
!backend/videos/subtitles/.gitkeep

backend/audio_files/**
!backend/audio_files/
!backend/audio_files/.gitkeep

backend/bgm_files/**
!backend/bgm_files/
!backend/bgm_files/.gitkeep

backend/outputs/**
!backend/outputs/
!backend/outputs/.gitkeep

# ── Remotion (렌더 엔진 · 산출물 · 대용량 데모 데이터) ──
backend/remotion/node_modules/
backend/remotion/out/
backend/remotion/.remotion/
frontend/remotion/node_modules/
frontend/remotion/out/
frontend/remotion/.remotion/

# Remotion 라이선스 폰트 (General Sans 등 재배포 불가)
frontend/remotion/public/fonts/

# 런타임 생성 spec (에이전트가 저장하는 결과물)
frontend/remotion/src/specs/agent/

# 사용자 업로드 자산 (프론트 preview 용)
frontend/public/assets/*
!frontend/public/assets/.gitkeep

# ── Scene24 legacy reference dump (필요 시 로컬 전용) ──
backend/agent/effects/*_scene24_full.*

# ── Research cache (트렌드 검색 24h TTL) ──
backend/.cache/

# ── Docker 볼륨 · 로그 ──
backend/postgres-data/
*.log

# ── 팀 원격 세션 임시 파일 ──
.claude-code-worktree/

# ── 다운로드 폰트 (scripts/download_fonts.py) ──
# 기본 NotoSansKR 만 커밋 — 스크립트 미실행 환경에서도 자막 렌더가 되게.
backend/assets/fonts/*
!backend/assets/fonts/NotoSansKR-Regular.ttf

# ── 루트 레벨 로컬 테스트 파일 (구 구조 잔재) ──
assets/
videos/
!backend/assets/fonts/NotoSansKR-Regular.ttf
# ── Windows Python venv ──
.venv-win/
backend/.venv-win/

# Python cache
__pycache__/

# ── 로컬 실행용 런타임 ──
backend/.runtime/

# ── 추가 미디어 생성 폴더 ──
backend/video_files/**
!backend/video_files/
!backend/video_files/.gitkeep

audio_files/**
bgm_files/**
video_files/**
output/**
outputs/**

# ── 로컬 테스트 로그 ──
simulation_*.log
codex_simulation_server*.log
