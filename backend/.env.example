# =============================================================
# Video Agent Backend — 환경변수 템플릿
#
# 사용법:
#   cp backend/.env.example backend/.env
#   그 다음 backend/.env 를 편집해서 실제 값 채워넣기.
#
# 이 파일은 git 에 올라감. 실제 backend/.env 는 절대 커밋 금지.
# =============================================================

# -------------------------------------------------------------
# Gemini (기본 LLM · 필수)
# -------------------------------------------------------------
# https://aistudio.google.com/apikey 에서 발급.
# 하나만 넣으면 모든 역할에 공통 사용. 팀원별 무료 티어 quota 나누고 싶으면
# 아래 역할별 키를 개별 설정 가능.
GOOGLE_API_KEY=

# 역할별 키 override (선택)
# GOOGLE_API_KEY_SUPERVISOR=
# GOOGLE_API_KEY_SCRIPT=
# GOOGLE_API_KEY_CRITIC=
# GOOGLE_API_KEY_SUB_AGENT=

# 모델 override (선택) — 미지정 시 gemini-2.5-flash
# MODEL_SUPERVISOR=gemini-2.5-flash
# MODEL_SCRIPT=gemini-2.5-flash
# MODEL_CRITIC=gemini-2.5-flash
# MODEL_SUB_AGENT=gemini-2.5-flash

# -------------------------------------------------------------
# OpenAI (Whisper 전사 · 필수)
# -------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 전사 엔진: openai (Whisper API) · gemini (Gemini 전사 경로)
WHISPER_ENGINE=openai
WHISPER_CHUNK_SECONDS=120

# 원본 전사 JSON 최초 생성 시 Gemini가 원본 미디어를 확인해 보수적으로 1회 교정.
# 같은 호출에서 화면용 반응 괄호/효과음 자막도 제안하되, 원문 segments와 분리 저장.
# 원본은 raw_segments, 실제 사용본은 segments, 감사/자막 연출은 correction에 저장.
TRANSCRIPT_POLISH=1
TRANSCRIPT_POLISH_MODEL=gemini-2.5-flash
TRANSCRIPT_POLISH_CONFIDENCE=0.85
TRANSCRIPT_POLISH_MIN_SIMILARITY=0.45
TRANSCRIPT_POLISH_UPLOAD_TIMEOUT=180
SUBTITLE_ENHANCE_CONFIDENCE=0.90
SUBTITLE_ENHANCE_MAX_RATIO=0.25
SUBTITLE_ENHANCE_MAX_SOUNDS=3

# -------------------------------------------------------------
# Anthropic (legacy · 선택)
# -------------------------------------------------------------
# 지금 파이프라인에선 미사용. 추후 Claude API 붙일 때만 필요.
ANTHROPIC_API_KEY=

# -------------------------------------------------------------
# ElevenLabs (TTS 나레이션 + BGM 생성 · 자막·나레이션 기능에만 필요)
# -------------------------------------------------------------
# https://elevenlabs.io 계정 만들고 발급.
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_MUSIC_MODEL=music_v2
ELEVENLABS_MUSIC_OUTPUT_FORMAT=mp3_44100_128

# -------------------------------------------------------------
# Research expert (트렌드 리서치 · 선택)
# -------------------------------------------------------------
# Tavily — https://app.tavily.com (월 1000 검색 무료)
TAVILY_API_KEY=

# YouTube Data API v3 — Google Cloud Console → API 활성화 (일 10k unit 무료)
# YOUTUBE_API_KEY=

# -------------------------------------------------------------
# 세션 로그 DB (필수 — docker-compose.yml 로 postgres 기동)
# -------------------------------------------------------------
# 로컬 default. Supabase / 원격 postgres 이관 시 URL 만 교체.
DATABASE_URL=postgresql+asyncpg://video_agent:video_agent_dev@localhost:5433/video_agent
