{
  "fps": 24,
  "brand": {
    "background": "#fdfdfc",
    "colors": ["#34d6c2", "#e85c9b", "#f4b94c"],
    "fontFamily": "Fraunces"
  },
  "scenes": [
    {
      "preset": "roll",
