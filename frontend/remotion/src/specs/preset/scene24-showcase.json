      "fontSize": 5.5,
      "fontWeight": 900,
      "emphasis": "strong"
    },
    {
      "preset": "hero_zoom",
      "text": "Scene24",
      "gradientStops": ["#34d6c2", "#e85c9b", "#f4b94c"],
      "flowSpeed": 2,
