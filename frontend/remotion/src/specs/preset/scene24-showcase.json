      "highlightCycle": ["#34d6c2", "#e85c9b", "#f4b94c"],
      "pacing": "punctuate",
      "exitSpeed": "fast",
      "baseColor": "#0c0a09",
      "duration": 2.6,
      "fontSize": 3.0,
      "fontWeight": 600
    },
    {
      "preset": "word_swap",
      "fromText": "still",
      "toText": "cinematic",
      "pace": "med",
      "holdSeconds": 0.3,
      "baseColor": "#0c0a09",
      "fontSize": 5.5,
      "fontWeight": 900,
      "emphasis": "strong"
    },
    {
      "preset": "beat",
      "text": "no designers",
      "background": "#0a0b0d",
      "baseColor": "#fdfdfc",
      "duration": 0.7,
      "fontSize": 5,
      "fontWeight": 800
    },
    {
      "preset": "beat",
      "text": "no agencies",
      "background": "#0a0b0d",
      "baseColor": "#fdfdfc",
      "duration": 0.7,
      "fontSize": 5,
      "fontWeight": 800
    },
    {
      "preset": "beat",
      "text": "no stock footage",
      "background": "#0a0b0d",
      "baseColor": "#fdfdfc",
      "duration": 0.8,
      "fontSize": 4.2,
      "fontWeight": 800
    },
    {
      "preset": "statement",
      "text": "just paste your URL.",
      "highlightWord": 3,
      "highlightCycle": ["#34d6c2", "#e85c9b", "#f4b94c"],
      "pacing": "punctuate",
      "exitSpeed": "med",
      "baseColor": "#0c0a09",
      "duration": 2.2,
      "fontSize": 3.2,
      "fontWeight": 600
    },
    {
      "preset": "stat_counter",
      "to": 60,
