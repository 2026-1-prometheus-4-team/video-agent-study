      "effects": {
        "glow": { "enabled": true, "intensity": 0.85, "radius": 42 }
      },
      "duration": 3.2
    },
    {
      "preset": "word_swap",
      "fromText": "Idea",
      "toText": "App",
      "baseColor": "#0F0F0F",
      "fontSize": 11,
      "fontWeight": 700,
      "pace": "med",
      "holdSeconds": 0.5,
      "spread": 1.0,
      "seed": 42
    },
    {
      "preset": "beat",
      "text": "Type.",
      "baseColor": "#0F0F0F",
      "fontSize": 4.5,
      "duration": 0.7
    },
    {
      "preset": "beat",
      "text": "Tweak.",
      "baseColor": "#0F0F0F",
      "emphasis": "strong",
      "duration": 0.7
    },
    {
      "preset": "beat",
      "text": "Ship.",
      "baseColor": "#FF5500",
      "fontSize": 6,
      "effects": {
        "glow": { "enabled": true, "intensity": 0.7, "radius": 50 }
      },
      "duration": 0.8
    },
    {
      "preset": "stat_counter",
