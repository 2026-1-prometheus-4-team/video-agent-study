{
  "fps": 24,
  "brand": {
    "background": "#FAF9F7",
    "colors": ["#22C9FF", "#FBB439", "#F0C5FF"],
    "fontFamily": "Familjen Grotesk, Inter, system-ui, sans-serif"
  },
  "scenes": [
    {
      "preset": "punch",
