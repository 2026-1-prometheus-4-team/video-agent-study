{
  "fps": 24,
  "brand": {
    "background": "#0A0512",
    "fontFamily": "Inter",
    "colors": ["#FF2EA6", "#A855F7"]
  },
  "scenes": [
    {
      "duration": 1.7,
      "transition_out": "hard_cut",
      "background": {
        "gradient": "radial-gradient(70% 80% at 50% 85%, #3A0E3C 0%, #1A0A26 55%, #0C0614 100%)"
      },
      "elements": [
        {
          "element": "text",
          "base": {
            "text": "Build anything",
            "fontSize": 7.5,
            "fontWeight": 600,
            "color": "#FFFFFF",
            "fontFamily": "Inter"
          },
          "layers": [
            {
              "type": "move",
              "role": "in",
              "props": { "fromX": 0, "fromY": -0.27, "toX": 0, "toY": -0.27, "duration": 1, "easing": "linear" }
            },
            {
              "type": "letter_stagger",
              "role": "in",
              "props": {
                "mode": "in",
                "order": "ltr",
                "staggerTotal": 6,
                "staggerEasing": "easeOut",
                "perLetter": {
                  "duration": 5,
                  "easing": "easeOut",
                  "channels": {
                    "opacity": { "from": 0, "to": 1 },
                    "y": { "from": 0.3, "to": 0 }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "duration": 1.2,
      "transition_out": "hard_cut",
      "background": {
        "gradient": "radial-gradient(60% 75% at 60% 45%, #3A1150 0%, #1F0A33 60%, #120620 100%)"
      },
      "elements": [
        {
          "element": "text",
          "base": {
            "text": "30x faster",
            "fontSize": 7,
            "fontWeight": 500,
            "color": "#FFFFFF",
            "fontFamily": "Inter"
          },
          "layers": [
            {
              "type": "fade",
              "role": "in",
              "props": { "duration": 5, "easing": "easeOut" }
            },
            {
              "type": "scale",
              "role": "in",
              "props": { "from": 0.96, "to": 1.0, "duration": 8, "easing": "easeOut" }
            }
          ]
        }
      ]
    }
  ]
}
