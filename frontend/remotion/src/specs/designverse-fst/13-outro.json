{
  "fps": 24,
  "brand": {
    "background": "#070310",
    "fontFamily": "Inter",
    "colors": ["#A855F7", "#FF2EA6"]
  },
  "scenes": [
    {
      "duration": 2.6,
      "transition_out": "fade",
      "background": {
        "gradient": "radial-gradient(50% 60% at 30% 40%, #1D0B2E 0%, #0C0616 60%, #070310 100%)"
      },
      "elements": [
        {
          "element": "badge_logo",
          "letter": "D",
          "wordmark": "DesignVerse",
          "size": 6,
          "wordmarkSize": 4.6,
          "gap": 1.6,
          "badgeColors": ["#8A5CF6", "#C026D3"],
          "rimColor": "#FF2EA6",
          "scaleIn": { "from": 0.7, "duration": 8, "easing": "easeOutBack" },
          "wordmarkIn": { "delay": 2, "duration": 7, "easing": "easeOut" }
        },
        {
          "element": "streak",
          "variant": "rect",
          "colors": ["#C026D3", "#FF2EA6"],
          "strokeWidth": 5,
          "glow": 0.9,
          "radius": 0.28,
          "box": { "x": 0.3, "y": 0.19, "w": 0.4, "h": 0.62 },
          "draw": { "start": 8, "duration": 28, "easing": "easeInOut" }
        }
      ]
