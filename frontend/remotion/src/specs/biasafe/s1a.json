            "timeline": [
              { "fill": { "type": "gradient", "stops": ["#9A11C8", "#540A7B"] }, "hold": 2, "transition": 5 },
              { "fill": { "type": "gradient", "stops": ["#6B2EAA", "#8A6BA2", "#9884AB"] }, "hold": 120 }
