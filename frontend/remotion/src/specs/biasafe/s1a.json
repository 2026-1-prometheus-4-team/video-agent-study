{
  "fps": 24,
  "brand": {
    "background": "#050507",
    "fontFamily": "Geist",
    "colors": ["#9B5CE8", "#C8B0F0", "#FFFFFF"]
  },
  "scenes": [
    {
      "duration": 2.5,
      "transition_out": "hard_cut",
      "elements": [
        {
          "element": "text",
          "base": {
            "text": "REDEFINING ASSET MANAGEMENT THROUGH",
            "fontSize": 2.3,
            "fontWeight": 500,
            "color": "#FFFFFF",
            "fontFamily": "Geist"
          },
          "color": {
