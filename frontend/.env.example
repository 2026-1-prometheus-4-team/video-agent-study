# =============================================================
# Video Agent Frontend — 환경변수 템플릿
#
# 사용법:
#   cp frontend/.env.example frontend/.env.local
#
# 이 파일은 git 에 올라감. 실제 frontend/.env.local 은 커밋 금지.
# NEXT_PUBLIC_* 접두어 값만 브라우저 번들에 포함됨 — 시크릿 넣지 말 것.
# =============================================================

# 백엔드 FastAPI URL. 로컬 개발은 http://localhost:8000
NEXT_PUBLIC_AGENT_API=http://localhost:8000

# WebSocket URL. 로컬은 ws://localhost:8000
NEXT_PUBLIC_AGENT_WS=ws://localhost:8000
